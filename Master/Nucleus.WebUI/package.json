{
  "name": "nucleus-webui",
  "private": true,
  "version": "0.1.0",
  "description": "Nucleus Co-op desktop UI (React, hosted in WebView2).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "bridge:gen": "node scripts/bridge-gen.mjs",
    "bridge:check": "node scripts/bridge-gen.mjs --check",
    "test:bridge": "node --test \"src/bridge/__tests__/*.test.ts\"",
    "i18n:gen": "node scripts/i18n.ts gen",
    "i18n:check": "node scripts/i18n.ts check",
    "i18n:lint": "node scripts/i18n.ts lint"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
