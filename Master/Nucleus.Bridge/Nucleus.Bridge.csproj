<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bridge between the React UI (WebView2) and the C# host: contract, runtime, contract model. No UI dependency. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Nucleus.Bridge</RootNamespace>
    <AssemblyName>Nucleus.Bridge</AssemblyName>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nucleus.Bridge.Tests" />
  </ItemGroup>

</Project>
