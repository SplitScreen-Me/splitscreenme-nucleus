  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
  <!-- Managed references (Nucleus.Gaming, Nucleus.Bridge, Nucleus.Coop.Services, WindowScrape, Jint, Newtonsoft.Json, NAudio,
       SharpDX, Ionic.Zip.Reduced, EasyHook.dll, with their .pdb) are copied to bin\: App.config probes privatePath="bin;webview".
       StartGame.exe (.exe.config, .pdb), a project reference, stays at the root with the native DLLs, Nucleus.IJx86/x64.exe and
       the hooks; its App.config probes bin\ as well. Items that already have a DestinationSubDirectory keep it. -->
  <Target Name="MoveManagedReferencesToBin" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Condition="'%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == '' And '%(ReferenceCopyLocalPaths.Filename)' != 'StartGame' And '%(ReferenceCopyLocalPaths.Filename)' != 'StartGame.exe'">
        <DestinationSubDirectory>bin\</DestinationSubDirectory>
      </ReferenceCopyLocalPaths>
    </ItemGroup>
  </Target>
  <!-- Web UI: copies Master\Nucleus.WebUI\dist (npm run build, not run by this build) to webui\ next to the exe.
       Without dist, webui\index.html becomes a placeholder page, so the window never shows an error page.
       webui\dev-server.txt (Debug: Vite dev server URL) is kept. -->
  <PropertyGroup>
    <WebUiDistDir>$(MSBuildProjectDirectory)\..\Nucleus.WebUI\dist\</WebUiDistDir>
    <WebUiOutputDir>$(TargetDir)webui\</WebUiOutputDir>
  </PropertyGroup>
  <Target Name="CopyWebUi" AfterTargets="Build" Condition="Exists('$(WebUiDistDir)index.html')">
    <ItemGroup>
      <WebUiStaleFiles Include="$(WebUiOutputDir)**\*" Exclude="$(WebUiOutputDir)dev-server.txt" />
      <WebUiDistFiles Include="$(WebUiDistDir)**\*" />
    </ItemGroup>
    <Delete Files="@(WebUiStaleFiles)" />
    <Copy SourceFiles="@(WebUiDistFiles)" DestinationFiles="@(WebUiDistFiles->'$(WebUiOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Web UI copied from $(WebUiDistDir) to $(WebUiOutputDir)" />
  </Target>
  <Target Name="WebUiPlaceholder" AfterTargets="Build" Condition="!Exists('$(WebUiDistDir)index.html') And !Exists('$(WebUiOutputDir)index.html')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Host\WebUiPlaceholder.html" DestinationFiles="$(WebUiOutputDir)index.html" />
    <Message Importance="high" Text="No web UI build in $(WebUiDistDir): wrote a placeholder $(WebUiOutputDir)index.html" />
  </Target>
  <!-- Languages: Master\i18n\*.json (en.json, the source of every string, and the translations) to i18n\ next to the exe,
       one file per language; the app lists the languages it finds there (docs/webui/i18n.md). Other files already in
       the output's i18n\ (a translation in progress) are kept. -->
  <Target Name="CopyI18n" AfterTargets="Build">
    <ItemGroup>
      <I18nFiles Include="$(MSBuildProjectDirectory)\..\i18n\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(I18nFiles)" DestinationFolder="$(TargetDir)i18n\" SkipUnchangedFiles="true" />
  </Target>
